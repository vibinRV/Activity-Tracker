@model Activity_Tracker.Models.AdminprojectList

@{
    ViewBag.Title = "AddEmployeeMembers";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>AddPersons</title>
    <style>
        :root {
            --body-font: "Montserrat", sans-serif;
        }

        * {
            font-family: var( --body-font);
        }

        body {
            background-color: #B3CCFF;
        }

        .login-box {
            position: absolute;
            margin-top: 27%;
            margin-left: 650px;
            transform: translate(-60%,-50%);
            background: #80AAFF;
            padding: 20px;
            width: 500px;
            border-radius: 10px;
            box-shadow: 0 15px 25px #B3CCFF;
        }

        h1 {
            font-size: 30px;
            margin: 0 0 40px;
            text-align: center;
            color: var(--black-color);
        }

        label {
            margin: 10px;
            padding: 10px;
            display: block;
            font-size: 20px;
        }

        input {
            margin: 10px;
            margin-left: 50%;
            margin-top: -40px;
            display: block;
            width: 40%;
            height: 20px;
        }

        textarea {
            margin: 10px;
            margin-left: 50%;
            margin-top: -40px;
            display: block;
            width: 40%;
            height: 40px;
        }

        button {
            font-size: 20px;
            padding: 5px;
            margin: 20px;
            margin-left: 45%;
            color: aquamarine;
            background-color: blueviolet;
        }
    </style>
</head>
<body>
    <div class="login-box">
        <form action="VerifyEmployeeMembers" method="post">
            <h1><span>ADD EMPLOYEES</span></h1>
            <label>Employee Name</label>
            <input type="text" name="emp_name" />
            <label>Employee Role</label>
            <input type="text" name="emp_role" />

            <button type="submit" name="submit">ADD</button>
        </form>
    </div>
</body>
</html>

