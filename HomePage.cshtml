@model Activity_Tracker.Models.AdminprojectList

@{
    Layout = "~/Views/Shared/AdminLayout.cshtml";
    var project_list = ViewBag.details;
    
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>HomePage</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css">
    <!--=============== REMIXICONS ===============-->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css" rel="stylesheet">

    <style>
        @@import url("https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600&display=swap");

        :root {
            --body-font: "Montserrat", sans-serif;
            --white-color: #fff;
        }

        * {
            font-family: var( --body-font);
        }

        body {
            background-color: #B3CCFF;
            height:700px;
        }
        .login-box {
            position: absolute;
            margin: 400px;
            margin-left: 650px;
            margin-top:30%;
            transform: translate(-50%,-50%);
            background: #80AAFF;
            padding: 30px;
            width: 700px;
            border-radius: 10px;
            box-shadow: 0 15px 25px #B3CCFF;
        }

        .login-box h1 {
            font-size: 30px;
            margin: 0 0 40px;
            text-align: center;
            color: var(--black-color);
        }

        table {
            border-collapse: collapse;
            width: 100%;
        }

        th {
            font-size: 20px;
        }

        td, th {
            border: 1.5px solid var(--black-color);
            text-align: left;
            padding: 8px;
        }
        tr:nth-child(even) {
            background-color: #dddddd;
        }

    </style>

</head>
<body>
    <div class="login-box">
        <h1>PROJECT</h1>
        <form action="" method="post">
            <table>
                <tr>
                    <th>project no</th>
                    <th>project name</th>
                    <th>project lead</th>
                    <th>project start date</th>
                    <th>project end date</th>
                    <th>Details</th>
                </tr>

                @{
                    foreach (var values in project_list)
                    {
                        int value = @values.project_no;
                        string s = @values.project_lead;
                                <tr>
                                    <td>@values.project_no</td>
                                    <td>@values.project_name</td>
                                    <td>@values.project_lead</td>
                                    <td>@values.project_start_date.ToShortDateString()</td>
                                    <td>@values.project_end_date.ToShortDateString()</td>
                                    <td><a href="@Url.Action("ViewProjectMembers", "Admin", new {value,s})">VIEW</a></td>
                                </tr>
                    }
                }
            </table>
            
        </form>
    </div>

    


</body>
</html>
