@model Activity_Tracker.Models.AdminprojectList

@{
    ViewBag.Title = "TeamLeadMembers";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
    var details = ViewBag.details;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>HomePage</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css">
    <!--=============== REMIXICONS ===============-->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css" rel="stylesheet">

    <style>
        @@import url("https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600&display=swap");

        :root {
            --body-font: "Montserrat", sans-serif;
            --white-color: #fff;
        }

        * {
            font-family: var( --body-font);
        }

        body {
            background-color: #B3CCFF;
            height: 700px;
        }

        .login-box {
            position: absolute;
            margin: 400px;
            margin-left: 650px;
            margin-top: 27%;
            transform: translate(-50%,-50%);
            background: #80AAFF;
            padding: 20px;
            width: 600px;
            border-radius: 10px;
            box-shadow: 0 15px 25px #B3CCFF;
        }

            .login-box h1 {
                font-size: 30px;
                margin: 0 0 40px;
                text-align: center;
                color: var(--black-color);
            }

        table {
            border-collapse: collapse;
            width: 100%;
        }

        th {
            font-size: 20px;
        }

        td, th {
            border: 1.5px solid var(--black-color);
            text-align: left;
            padding: 8px;
        }

        tr:nth-child(even) {
            background-color: #dddddd;
        }
        button {
            padding: 5px;
            margin-left: 80%;
            background-color: var(--black-color);
        }

        .btn-add {
            color: var(--white-color);
        }
    </style>

</head>
<body>
    <div class="login-box">
        <button><a class="btn-add" href="@Url.Action("AddTeamLeadMembers","Admin")">Add Team Lead</a></button>
        <h1>TEAM LEADS</h1>
        <form action="" method="post">
            <table>
                <tr>
                    <th>SNo</th>
                    <th>Team Lead Name</th>
                    <th>Team Lead Role</th>
                </tr>
                @{
                    int inc = 0;
                    foreach (var list in details)
                    {
                        inc++;
                        <tr>
                            <td>@inc</td>
                            <td>@list.team_lead_members</td>
                          <td>@list.team_lead_role</td>
                        </tr>

                    }
                }
            </table>

        </form>
    </div>
</body>
</html>

